# macOS
.DS_Store

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip

# The generated Xcode project IS committed, so the repo can be opened and run with
# only Xcode installed — no terminal, no Homebrew, no XcodeGen. project.yml remains
# the source of truth: change structure there, run `xcodegen generate`, commit both.
# Per-user Xcode state stays out.
ASLVisionPro.xcodeproj/xcuserdata/
ASLVisionPro.xcodeproj/project.xcworkspace/xcuserdata/

# Claude Code local settings
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/

# Training artifacts (large / regenerable)
training/data/*.npz
ckpt*.pt
*.mlmodelc

# The shipped model IS committed — it's 900 KB and the app is inert without it.
# Intermediate models produced during training are not.
training/*.mlpackage

# Enterprise license — NEVER commit; issued per-team by Apple
Enterprise.license

# Kaggle subset (re-downloadable via training/fetch_subset.py)
training/data/asl_signs/
training/*.npz
