# macOS
.DS_Store

# Xcode
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip

# XcodeGen output — the project is GENERATED from project.yml.
# Run `xcodegen generate` after cloning. Committing project.pbxproj invites
# brutal merge conflicts; project.yml is the source of truth.
ASLVisionPro.xcodeproj/

# Claude Code local settings
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/

# Training artifacts (large / regenerable)
training/data/*.npz
ckpt*.pt
*.mlmodelc

# The shipped model IS committed — it's 900 KB and the app is inert without it.
# Intermediate models produced during training are not.
training/*.mlpackage

# Enterprise license — NEVER commit; issued per-team by Apple
Enterprise.license

# Kaggle subset (re-downloadable via training/fetch_subset.py)
training/data/asl_signs/
training/*.npz
