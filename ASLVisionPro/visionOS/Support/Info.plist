<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Core bundle keys. Values are substituted from build settings at compile time. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationPreferredDefaultSceneSessionRole</key>
        <string>UIWindowSceneSessionRoleApplication</string>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>

    <!-- Required usage strings. Shown to the wearer; be explicit that you observe another person. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Listen mode transcribes nearby speech so it can be shown as captions. Audio is processed on device and is not recorded or sent anywhere.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Speech is transcribed on device to display live captions.</string>
    <key>NSCameraUsageDescription</key>
    <string>ASL Vision Pro uses the forward camera to observe a person signing and generate on-device captions. Video is processed on device and is not recorded or sent anywhere.</string>
    <key>NSWorldSensingUsageDescription</key>
    <string>Used to detect and track the person signing in front of you.</string>
    <key>NSHandsTrackingUsageDescription</key>
    <string>Tutor mode tracks your hands so it can check your signing and give feedback. Hand data is processed on device and is not recorded or sent anywhere.</string>
</dict>
</plist>
